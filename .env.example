# Runtime
PORT=8000
KOS_ENV=development

# Persistência local; monte um volume neste caminho em produção.
KOS_DATABASE_PATH=data/kos.db

# GitHub runtime connector
# Use um token restrito ao repositório necessário. Nunca faça commit do valor real.
KOS_GITHUB_TOKEN=
KOS_GITHUB_REPOSITORY=vkb-lab/OS-v1

# Integração futura com Kaizen Publish
KAIZEN_PUBLISH_API_URL=
KAIZEN_PUBLISH_API_TOKEN=

# Local worker
KOS_LOCAL_WORKER_ENABLED=false
KOS_LOCAL_ALLOWED_ROOTS=C:\Users\oi\Desktop;C:\Users\oi\Documents

# Banco gerenciado da próxima fase
DATABASE_URL=

# Google Workspace / OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_WORKSPACE_DOMAIN=kaizen-org.com
GOOGLE_SYSTEM_EMAIL=
